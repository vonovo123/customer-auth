# API origin (no trailing slash)
VITE_API_BASE_URL=https://interview.honestfund.kr

# Production CORS proxy origin (no trailing slash).
# Leave empty for local Vite proxy (/api).
# Example after deploying workers/cors-proxy.js to Cloudflare Workers:
# VITE_CORS_PROXY_URL=https://your-worker.your-subdomain.workers.dev
VITE_CORS_PROXY_URL=
